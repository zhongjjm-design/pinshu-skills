{
  "schema_version": 1,
  "course_id": "example-course",
  "course_title": "Example Course",
  "lecturer": "Lecturer Name",
  "course_root": "/absolute/path/to/course",
  "runtime_dir": "/absolute/path/to/runtime",
  "source_adapter": "baidu-transcript",
  "output_language": "match-user",
  "course_purpose": ["systematic_learning"],
  "purpose_decision_basis": "The course is intended for systematic study and long-term review.",
  "assurance_mode": "standard",
  "assurance_decision_basis": "This is a terminology-dense professional course with complete sources, so standard evidence is appropriate.",
  "production_profile": "standard",
  "adapters": {"domain": ["generic"], "content": ["talk"]},
  "optional_extensions": {"active_recall": true, "learning_training": true, "horizontal_topics": false},
  "external_use": {"enabled": false, "intended_uses": []},
  "intake_confirmation": {"confirmed": false, "confirmed_by": "", "confirmed_at": ""},
  "budgets": {
    "max_tokens_per_lesson": 500000,
    "max_wall_minutes_per_lesson": 45,
    "max_agent_calls_per_lesson": 3,
    "max_reworks_per_lesson": 1,
    "max_qa_rounds_per_lesson": 2
  },
  "sample_gate": {"lesson_no": 1, "approved": false},
  "naming_template": "Lesson-{lesson_no:02d}-{title}.md",
  "path_templates": {
    "source": "00_Source_Transcripts/{filename}",
    "official_faithful": "01_Faithful_Edits/{filename}",
    "official_lecture": "02_Structured_Lectures/{filename}",
    "course_map": "00_Course_Map.md",
    "content_master_lesson": "05_Content_Assets/{filename}",
    "content_master_course": "05_Content_Assets/00_Course_Content_Master.md",
    "active_recall": "03_Review_and_Practice/01_Active_Recall/{filename}",
    "training_bank": "03_Review_and_Practice/02_Practice_Bank/{filename}",
    "learning_progress": "04_Learning_Records/00_Progress.md",
    "learning_sessions": "04_Learning_Records/01_Practice_Sessions",
    "error_review": "04_Learning_Records/02_Errors_and_Rechecks.md",
    "learning_asset_index": "99_Production_Control/Learning_Asset_Index"
  },
  "writer_model": "unassigned",
  "qa_model": "unassigned",
  "strong_model": "unassigned",
  "gold_samples": [],
  "lessons": [
    {"lesson_no": 1, "title": "Official Title", "source_video": "01_Official_Title.mp4", "source_path": "/My Resources/Course/01_Official_Title.mp4"},
    {
      "lesson_no": 2,
      "title": "Critical Procedure",
      "source_video": "02_Critical_Procedure.mp4",
      "source_path": "/My Resources/Course/02_Critical_Procedure.mp4",
      "overrides": {"assurance_mode": "strict", "force_independent_qa": true, "risk_flags": ["high_consequence_operation"]},
      "override_reason": "The lesson contains actions with real-world consequences."
    }
  ]
}
